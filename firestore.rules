rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // 輔助函式
    // ========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() && (
        request.auth.token.role == 'teacher' ||
        request.auth.token.role == 'admin'
      );
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ========================================
    // 1. 單字庫 vocabulary
    // ========================================
    match /vocabulary/{docPath=**} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // ========================================
    // 2. 作業 assignments
    // ========================================
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // ========================================
    // 3. 學生資料 students/{studentId}
    //    students/{uid} 只保留為「登入身份映射」：
    //    name, class, seatNumber, displayId
    // ========================================
    match /students/{studentId} {
      allow read: if isSelf(studentId) || isTeacher();
      allow write: if isSelf(studentId);

      match /{document=**} {
        allow read: if isSelf(studentId) || isTeacher();
        allow write: if isSelf(studentId);
      }
    }

    // ========================================
    // 4. 學生狀態 studentStates/{displayId}
    //    包含：學習狀態、SM-2 進度、每日快照
    //    Key 為 displayId（如 "709_1_林佑綸"）
    // ========================================
    match /studentStates/{displayId} {
      // 教師可讀寫；學生（含匿名）可讀寫
      // 安全性依賴「學生不知道別人的 displayId」
      allow read: if isTeacher() || isSignedIn();
      allow write: if isTeacher() || isSignedIn();

      match /{document=**} {
        allow read: if isTeacher() || isSignedIn();
        allow write: if isTeacher() || isSignedIn();
      }
    }

    // ========================================
    // 5. 作答紀錄 attempts
    //    🔥 學生可讀（PerformanceTracker 在學生端執行）
    // ========================================
    match /attempts/{attemptId} {
      allow read: if isTeacher() || isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid;

      allow update, delete: if false;
    }

    // ========================================
    // 6. 班級統計 classStats
    //    🔥 簡化驗證（嵌套結構 + increment 無法用頂層欄位檢查）
    // ========================================
    match /classStats/{className} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ========================================
    // 7. 歸檔學生 archived_students
    // ========================================
    match /archived_students/{displayId} {
      allow read: if isTeacher();
      allow create, update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ========================================
    // 8. 白名單策略：未明確允許的集合一律拒絕
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}