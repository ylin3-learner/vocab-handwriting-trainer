rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // 輔助函式
    // ========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() && (
        request.auth.token.role == 'teacher' ||
        request.auth.token.role == 'admin'
      );
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ========================================
    // 1. 單字庫 vocabulary
    // ========================================
    match /vocabulary/{docPath=**} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // ========================================
    // 2. 作業 assignments
    // ========================================
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // ========================================
    // 3. 學生資料 students/{studentId}
    //
    //    students/{uid} 只保留為「登入身份映射」：
    //    name, class, seatNumber, displayId
    //
    // 🔥 修改：放寬 delete，讓學生清理自己的舊 uid profile
    //
    //    為什麼放寬？
    //      - 匿名登入每次 refresh 產生新 uid，
    //        舊 uid 的 profile 需要被清理，否則累積髒資料。
    //      - 但刪除者（新 uid）與被刪者（舊 uid）不同，
    //        原本的 isSelf() 會拒絕。
    //
    //    風險評估（為什麼安全）：
    //      1. students/{uid} 只存 profile（無學習資料）
    //      2. 學習資料在 studentStates/{displayId}，跨 UID，不受影響
    //      3. uid 不可猜測，學生無法得知他人的 uid
    //      4. 誤刪時，學生下次登入會重建 profile
    //      5. 教師儀表板已按 displayId 合併，不受重複 profile 影響
    //
    //    最壞情況：某學生惡意刪除他人 profile
    //      → 受害者下次登入時重建，學習進度完好無損
    // ========================================
    match /students/{studentId} {
      allow read: if isSelf(studentId) || isTeacher();
      allow create, update: if isSelf(studentId);
      allow delete: if isSignedIn();  // 🔥 放寬

      match /{document=**} {
        allow read: if isSelf(studentId) || isTeacher();
        allow write: if isSelf(studentId);
      }
    }

    // ========================================
    // 4. 學生狀態 studentStates/{displayId}
    // ========================================
    match /studentStates/{displayId} {
      allow read: if isTeacher() || isSignedIn();
      allow write: if isTeacher() || isSignedIn();

      match /{document=**} {
        allow read: if isTeacher() || isSignedIn();
        allow write: if isTeacher() || isSignedIn();
      }
    }

    // ========================================
    // 5. 作答紀錄 attempts
    // ========================================
    match /attempts/{attemptId} {
      allow read: if isTeacher() || isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid;

      allow update, delete: if false;
    }

    // ========================================
    // 6. 班級統計 classStats
    // ========================================
    match /classStats/{className} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ========================================
    // 7. 歸檔學生 archived_students
    // ========================================
    match /archived_students/{displayId} {
      allow read: if isTeacher();
      allow create, update: if isTeacher();
      allow delete: if isTeacher();
    }

    // ========================================
    // 8. 白名單策略：未明確允許的集合一律拒絕
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}